      "rules": [
        { "icon": "1\ufe0f\u20e3", "text": "Pick the nearest base (10, 100, 1000)" },
        { "icon": "2\ufe0f\u20e3", "text": "Find each number's deviation from base" },
        { "icon": "3\ufe0f\u20e3", "text": "Cross-subtract: number + other's deviation" },
        { "icon": "\u2705", "text": "Multiply the two deviations for the right part" }
      ]
    },

    "visualExample": {
      "problem": "97 \u00d7 96",
      "displayEquation": "97 \u00d7 96",
      "steps": [
        { "num": 1, "title": "Deviations from 100", "calc": "97\u2192\u22123, 96\u2192\u22124" },
        { "num": 2, "title": "Cross-subtract", "calc": "97\u22124 = 93" },
        { "num": 3, "title": "Multiply deviations", "calc": "(\u22123)\u00d7(\u22124) = 12" },
        { "num": "\u2713", "title": "Answer", "calc": "= 9312", "isAnswer": true }
      ]
    },

