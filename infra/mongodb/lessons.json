    "slug": "ekadhikena-purvena",
    "sanskritName": "Ekadhikena Purvena",
    "englishMeaning": "By One More Than the Previous One",
    "icon": "➕",
    "difficulty": "easy",
    "scope": "Squaring numbers ending in 5",
    "themeColor": "#7C3AED",
    "order": 1,
    "isLocked": false,
    "xpReward": 80,
    "estimatedMinutes": 8,

    "intro": {
      "description": "Instantly square any number ending in 5. A simple pattern that turns intimidating squares into two quick steps.",
      "whatYouLearn": [
        "Identify numbers ending in 5",
        "Multiply the leading digit by itself+1",
        "Append 25 to complete the square"
      ]
    },

    "concept": {
      "title": "The Core Method",
      "formula": "n5\u00b2 = [n \u00d7 (n+1)] | 25",
      "formulaNote": "Multiply, then append 25",
      "rules": [
        { "icon": "1\ufe0f\u20e3", "text": "Take the leading digit(s) before the 5" },
        { "icon": "2\ufe0f\u20e3", "text": "Multiply it by itself plus one" },
        { "icon": "3\ufe0f\u20e3", "text": "Append 25 to the result" },
        { "icon": "\u2705", "text": "That combined number is your answer" }
      ]
    },

    "visualExample": {
      "problem": "35\u00b2",
      "displayEquation": "35 \u00d7 35",
      "steps": [
        { "num": 1, "title": "Leading digit", "calc": "3 (before the 5)" },
        { "num": 2, "title": "Multiply n \u00d7 (n+1)", "calc": "3 \u00d7 4 = 12" },
        { "num": 3, "title": "Append 25", "calc": "12 | 25" },
        { "num": "\u2713", "title": "Answer", "calc": "= 1225", "isAnswer": true }
      ]
    },

